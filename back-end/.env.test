# .env.test - Test environment configuration

NODE_ENV=test

# JWT Configuration
JWT_SECRET=test-jwt-secret-key-for-testing-12345

# API Keys (use test/mock keys)
GEMINI_API_KEY=test-gemini-api-key-12345
WEATHER_API_KEY=test-openweather-api-key-12345

# Database Configuration (if using real DB for integration tests)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatbot_test
DB_USER=test_user
DB_PASSWORD=test_password

# Redis Configuration (if using)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Logging
LOG_LEVEL=error

# Test-specific settings
DISABLE_AUTH=false
MOCK_EXTERNAL_APIS=true